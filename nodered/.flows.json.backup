  {
    "id": "gauge_t1",
    "type": "ui-gauge",
    "z": "tab_red_agua",
    "name": "T1",
    "group": "ui_group_medidores",
    "order": 1,
    "width": 2,
    "height": 3,
    "gtype": "gauge-half",
    "gstyle": "needle",
    "title": "Tramo T1",
    "units": "m³/h",
    "min": 0,
    "max": 100,
    "x": 750,
    "y": 280,
    "wires": [
      []
    ],
    "segments": [
      {
        "from": "0",
        "color": "#0284c7",
        "text": "",
        "textType": "label"
      },
      {
        "from": "60",
        "color": "#eab308",
        "text": "",
        "textType": "label"
      },
      {
        "from": "80",
