[
  {
    "id": "tab_red_agua",
    "type": "tab",
    "label": "Red de Agua - En Vivo",
    "disabled": false,
    "info": "Flujo Nivel 5 sin nodos function: Kafka -> change/switch -> Dashboard 2.0"
  },
  {
    "id": "kafka_broker_red_agua",
    "type": "oriolrius-kafka-broker",
    "name": "Clúster Kafka KRaft",
    "hosts": "localhost:9092,localhost:9094,localhost:9096",
    "usesasl": false,
    "usetls": false
  },
  {
    "id": "ui_base_agua",
    "type": "ui-base",
    "name": "Red de Agua",
    "path": "/dashboard",
    "includeClientData": true,
    "acceptsClientConfig": [
      "ui-notification",
      "ui-control"
    ],
    "showPathInSidebar": false,
    "navigationStyle": "default"
  },
  {
    "id": "ui_theme_agua",
    "type": "ui-theme",
    "name": "Tema Agua",
    "colors": {
      "surface": "#ffffff",
      "primary": "#0284c7",
      "bgPage": "#f1f5f9",
      "groupBg": "#ffffff",
      "groupOutline": "#cbd5e1"
    },
    "sizes": {
      "density": "default",
      "pagePadding": "12px",
      "groupGap": "12px",
      "groupBorderRadius": "6px",
      "widgetGap": "12px"
    }
  },
  {
    "id": "ui_page_vivo",
    "type": "ui-page",
    "name": "Monitorización en Vivo",
    "ui": "ui_base_agua",
    "path": "/vivo",
    "icon": "water",
    "layout": "grid",
    "theme": "ui_theme_agua",
    "order": 1,
    "visible": true,
    "disabled": false
  },
  {
    "id": "ui_group_graficas",
    "type": "ui-group",
    "name": "Evolución Temporal (5 Tramos)",
    "page": "ui_page_vivo",
    "width": 12,
    "height": 1,
    "order": 1,
    "showTitle": true,
    "visible": true,
    "disabled": false,
    "groupType": "default"
  },
  {
    "id": "ui_group_medidores",
    "type": "ui-group",
    "name": "Caudal Actual por Tramo",
    "page": "ui_page_vivo",
    "width": 12,
    "height": 1,
    "order": 2,
    "showTitle": true,
    "visible": true,
    "disabled": false,
    "groupType": "default"
  },
  {
    "id": "kafka_in_lecturas",
    "type": "oriolrius-kafka-consumer",
    "z": "tab_red_agua",
    "name": "Kafka: lecturas",
    "broker": "kafka_broker_red_agua",
    "topic": "lecturas",
    "groupid": "",
    "fromOffset": "latest",
    "outOfRangeOffset": "latest",
    "encoding": "utf8",
    "useSchemaValidation": false,
    "x": 140,
    "y": 220,
    "wires": [
      [
        "chg_prep_caudal",
        "chg_prep_presion",
        "sw_tramo"
      ]
    ]
  },
  {
    "id": "chg_prep_caudal",
    "type": "change",
    "z": "tab_red_agua",
    "name": "Serie = tramo, Valor = caudal_entrada",
    "rules": [
      {
        "t": "set",
        "p": "topic",
        "pt": "msg",
        "to": "payload.tramo",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "payload.caudal_entrada",
        "tot": "msg"
      }
    ],
    "x": 450,
    "y": 120,
    "wires": [
      [
        "chart_caudal"
      ]
    ]
  },
  {
    "id": "chart_caudal",
    "type": "ui-chart",
    "z": "tab_red_agua",
    "group": "ui_group_graficas",
    "name": "Gráfica Caudal",
    "label": "Caudal de Entrada (m³/h)",
    "order": 1,
    "width": 6,
    "height": 6,
    "chartType": "line",
    "category": "topic",
    "categoryType": "msg",
    "xAxisProperty": "",
    "xAxisPropertyType": "timestamp",
    "xAxisType": "time",
    "xAxisFormat": "",
    "xAxisFormatType": "auto",
    "yAxisLabel": "m³/h",
    "yAxisProperty": "payload",
    "yAxisPropertyType": "msg",
    "ymin": "25",
    "ymax": "75",
    "action": "append",
    "removeOlder": "2",
    "removeOlderUnit": "60",
    "removeOlderPoints": "",
    "interpolation": "linear",
    "showLegend": true,
    "x": 760,
    "y": 120,
    "wires": [
      []
    ]
  },
  {
    "id": "chg_prep_presion",
    "type": "change",
    "z": "tab_red_agua",
    "name": "Serie = tramo, Valor = presion",
    "rules": [
      {
        "t": "set",
        "p": "topic",
        "pt": "msg",
        "to": "payload.tramo",
        "tot": "msg"
      },
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "payload.presion",
        "tot": "msg"
      }
    ],
    "x": 430,
    "y": 200,
    "wires": [
      [
        "chart_presion"
      ]
    ]
  },
  {
    "id": "chart_presion",
    "type": "ui-chart",
    "z": "tab_red_agua",
    "group": "ui_group_graficas",
    "name": "Gráfica Presión",
    "label": "Presión por Tramo (bar)",
    "order": 2,
    "width": 6,
    "height": 6,
    "chartType": "line",
    "category": "topic",
    "categoryType": "msg",
    "xAxisProperty": "",
    "xAxisPropertyType": "timestamp",
    "xAxisType": "time",
    "xAxisFormat": "",
    "xAxisFormatType": "auto",
    "yAxisLabel": "bar",
    "yAxisProperty": "payload",
    "yAxisPropertyType": "msg",
    "ymin": "2",
    "ymax": "4",
    "action": "append",
    "removeOlder": "2",
    "removeOlderUnit": "60",
    "removeOlderPoints": "",
    "interpolation": "linear",
    "showLegend": true,
    "x": 760,
    "y": 200,
    "wires": [
      []
    ]
  },
  {
    "id": "sw_tramo",
    "type": "switch",
    "z": "tab_red_agua",
    "name": "Separar por Tramo",
    "property": "payload.tramo",
    "propertyType": "msg",
    "rules": [
      {
        "t": "eq",
        "v": "T1",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "T2",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "T3",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "T4",
        "vt": "str"
      },
      {
        "t": "eq",
        "v": "T5",
        "vt": "str"
      }
    ],
    "checkall": "false",
    "repair": false,
    "outputs": 5,
    "x": 380,
    "y": 360,
    "wires": [
      [
        "chg_t1"
      ],
      [
        "chg_t2"
      ],
      [
        "chg_t3"
      ],
      [
        "chg_t4"
      ],
      [
        "chg_t5"
      ]
    ]
  },
  {
    "id": "chg_t1",
    "type": "change",
    "z": "tab_red_agua",
    "name": "T1 caudal",
    "rules": [
      {
        "t": "set",
        "p": "payload",
        "pt": "msg",
        "to": "payload.caudal_entrada",
        "tot": "msg"
      }
    ],
    "x": 580,
    "y": 280,
    "wires": [
      [
        "gauge_t1"
      ]
    ]
  },
  {
