# Versiones (fijadas para que la defensa sea reproducible)
KAFKA_VERSION=4.3.2
KAFKA_UI_VERSION=latest

# ID fijo del clúster KRaft. Se genera UNA sola vez (ver paso 1 de la prueba)
KAFKA_CLUSTER_ID=PEGA_AQUI_EL_UUID

# Host que se anuncia a los clientes de fuera de Docker.
# En el nivel 10 se cambia por la IP del servidor.
KAFKA_HOST_EXTERNO=localhost

# TimescaleDB / PostgreSQL
TIMESCALE_VERSION=latest-pg16
POSTGRES_DB=red_agua
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
TIMESCALE_PORT=5432

# Parámetros del motor determinista (Nivel 5)
# T0 = 2026-01-01 00:00:00 UTC (en segundos enteros)
T0=1767225600
TPS=1
