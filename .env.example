# Versiones (fijadas para que la defensa sea reproducible)
KAFKA_VERSION=4.3.2
KAFKA_UI_VERSION=latest

# ID fijo del clúster KRaft. Se genera UNA sola vez (p. ej. con kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=GENERA_TU_PROPIO_UUID_AQUI

# Host que se anuncia a los clientes de fuera de Docker.
# En despliegue distribuido se cambia por la IP del servidor.
KAFKA_HOST_EXTERNO=localhost

# TimescaleDB / PostgreSQL (cambia la clave en tu archivo .env local)
TIMESCALE_VERSION=latest-pg16
POSTGRES_DB=red_agua
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave_por_la_tuya
TIMESCALE_PORT=5432

# Parámetros del motor determinista (Nivel 5)
# T0 = 2026-01-01 00:00:00 UTC (en segundos enteros)
T0=1767225600
TPS=1

